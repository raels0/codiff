{
  "name": "Licht",
  "appearance": "light",
  "style": {
    "background": "#fffefc",
    "text": "#111111",
    "editor.background": "#fffefc",
    "editor.foreground": "#111111",
    "editor.active_line.background": "#a5a5a520",
